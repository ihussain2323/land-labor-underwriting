{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "property": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string",
            "minLength": 1
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "location",
          "as_of",
          "scope"
        ],
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "object",
      "required": [
        "purchase_price",
        "buyer_cost_rate",
        "close_date",
        "hold_months",
        "exit_cap",
        "sale_cost_rate",
        "gp_share",
        "acquired_units",
        "acquired_rsf",
        "current_leasing",
        "forecast_leasing",
        "renewal_rate",
        "market_rent_growth",
        "opex_growth",
        "property_management",
        "asset_management",
        "annual_reserve_per_unit",
        "other_income",
        "renovation",
        "tax_schedule",
        "surcharge",
        "loan_structure",
        "promote"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/decision"
      },
      "properties": {
        "buyer_cost_rate": {
          "$ref": "#/$defs/decision",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ]
            }
          }
        },
        "sale_cost_rate": {
          "$ref": "#/$defs/decision",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ]
            }
          }
        },
        "gp_share": {
          "$ref": "#/$defs/decision",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ]
            }
          }
        },
        "renewal_rate": {
          "$ref": "#/$defs/decision",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ]
            }
          }
        },
        "forecast_leasing": {
          "$ref": "#/$defs/decision",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ]
            }
          }
        },
        "current_leasing": {
          "$ref": "#/$defs/decision",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ]
            }
          }
        },
        "property_management": {
          "$ref": "#/$defs/decision",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ]
            }
          }
        },
        "asset_management": {
          "$ref": "#/$defs/decision",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ]
            }
          }
        },
        "annual_reserve_per_unit": {
          "$ref": "#/$defs/decision",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            }
          }
        },
        "retail_area": {
          "$ref": "#/$defs/decision",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            }
          }
        },
        "market_rent_growth": {
          "$ref": "#/$defs/decision",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "exclusiveMinimum": -1
                }
              ]
            }
          }
        },
        "opex_growth": {
          "$ref": "#/$defs/decision",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "exclusiveMinimum": -1
                }
              ]
            }
          }
        },
        "purchase_price": {
          "$ref": "#/$defs/decision",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              ]
            }
          }
        },
        "exit_cap": {
          "$ref": "#/$defs/decision",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                }
              ]
            }
          }
        },
        "hold_months": {
          "$ref": "#/$defs/decision",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ]
            }
          }
        },
        "acquired_units": {
          "$ref": "#/$defs/decision",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ]
            }
          }
        },
        "loan_structure": {
          "$ref": "#/$defs/decision",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "cash",
                        "fixed_io_at_close",
                        "custom"
                      ]
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "fixed_io_at_close"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "ltv": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "amount": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "fee_rate": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "rate": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "maximum": 1
                          },
                          "term_months": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "required": [
                          "fee_rate",
                          "rate",
                          "term_months"
                        ],
                        "oneOf": [
                          {
                            "required": [
                              "amount"
                            ]
                          },
                          {
                            "required": [
                              "ltv"
                            ]
                          }
                        ]
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "custom"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "description"
                        ],
                        "properties": {
                          "description": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            }
          }
        },
        "close_date": {
          "$ref": "#/$defs/decision",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "format": "date"
                }
              ]
            }
          }
        },
        "unit_type_order": {
          "$ref": "#/$defs/decision",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              ]
            }
          }
        },
        "history_accounts": {
          "$ref": "#/$defs/decision",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              ]
            }
          }
        },
        "starting_rent_by_type": {
          "$ref": "#/$defs/decision",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              ]
            }
          }
        },
        "operating_lines": {
          "$ref": "#/$defs/decision",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "account",
                      "selector",
                      "input"
                    ],
                    "properties": {
                      "account": {
                        "type": "string",
                        "minLength": 1
                      },
                      "selector": {
                        "enum": [
                          "$ / Unit",
                          "% of EGR"
                        ]
                      },
                      "input": {
                        "type": "number"
                      },
                      "growth": {
                        "type": "number",
                        "exclusiveMinimum": -1
                      }
                    },
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "selector": {
                              "const": "% of EGR"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "input": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        },
        "history_income_complete": {
          "$ref": "#/$defs/decision",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          }
        },
        "expected_year1_noi": {
          "$ref": "#/$defs/decision",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            }
          }
        }
      }
    },
    "roll": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "basis": {
              "type": "string",
              "minLength": 1
            },
            "units": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rsf": {
                    "anyOf": [
                      {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "contract": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "legal": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "market": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "leased": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  }
                },
                "required": [
                  "id",
                  "type",
                  "rsf",
                  "contract",
                  "legal",
                  "market",
                  "leased"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "source",
            "basis",
            "units"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "t12": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "start": {
              "type": "string",
              "format": "date"
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "reported_expenses": {
              "type": "number"
            },
            "expenses": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 12,
                "maxItems": 12
              }
            }
          },
          "required": [
            "source",
            "start",
            "scope",
            "reported_expenses",
            "expenses"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "next_evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "item",
          "impact",
          "next_evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "property",
    "as_of",
    "sources",
    "decisions",
    "roll",
    "t12",
    "issues"
  ],
  "additionalProperties": false,
  "$defs": {
    "decision": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "given",
            "derived",
            "instruction",
            "precedent",
            "scenario",
            "unknown",
            "not_applicable"
          ]
        },
        "value": {},
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "destination": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "value",
        "unit",
        "source",
        "basis",
        "destination"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unknown",
                  "not_applicable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      ]
    }
  }
}
